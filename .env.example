# .env.example — Variables de configuración seguras (P.2 Environment Separation)
#
# SOLO placeholders seguros. NO incluir tokens, passwords ni IDs productivos.
# Las credenciales de proveedores (O.5/O.9) y secretos se gestionan por el
# Secret Manager (N.5) mediante secret references; nunca se versionan.
#
# Entorno canónico: APP_ENV es la single source of truth (P.2).
# Valores válidos: development | staging | production
APP_ENV=development

# --- Red / servidor ---
HOST=0.0.0.0
PORT=8000

# --- Persistencia (P.2 data root isolation: data/<environment>) ---
# Ejemplos por entorno:
#   development -> data/development
#   staging     -> data/staging
#   production  -> data/production
DATA_DIR=data/development

# --- Logging (P.2: production no admite DEBUG) ---
# development: DEBUG permitido | staging: INFO | production: WARNING
LOG_LEVEL=DEBUG

# --- Namespace de secretos (opcional; validado contra el environment) ---
# development -> dev | staging -> staging | production -> prod
# SECRET_NAMESPACE=dev

# --- Versión de la aplicación (reportada de forma segura por /health) ---
APP_VERSION=0.1.0

# --- Flags de la plataforma (valores booleanos) ---
ENABLE_ADMIN_CONSOLE=true
ENABLE_OAUTH=true
READINESS_PROBES_ENABLED=true
LIVENESS_PROBES_ENABLED=true